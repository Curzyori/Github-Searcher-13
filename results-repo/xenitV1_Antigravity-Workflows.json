     ├── ultrathink.md\n        ├── architecture.md\n        └── ...\n\n~/.agent/                               # Agents\n└── agents/                             # 16 Specialized Agents\n    ├── orchestrator.md\n    ├── backend-specialist.md\n    └── ...\n</code></pre></div>\n<hr>\n<div class=\"markdown-heading\" dir=\"auto\"><h2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\">🤖 Available Agents (16)</h2><a id=\"user-content--available-agents-16\" class=\"anchor\" aria-label=\"Permalink: 🤖 Available Agents (16)\" href=\"#-available-agents-16\"><svg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"></path></svg></a></div>\n<markdown-accessiblity-table><table>\n<thead>\n<tr>\n<th>Agent</th>\n<th>Domain &amp; Focus</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>orchestrator</code></td>\n<td>Multi-agent coordination and synthesis</td>\n</tr>\n<tr>\n<td><code>project-planner</code></td>\n<td>Discovery, Architecture, and Task Planning</td>\n</tr>\n<tr>\n<td><code>backend-specialist</code></td>\n<td>Backend Architect (API + Database + Server)</td>\n</tr>\n<tr>\n<td><code>database-architect</code></td>\n<td>Database Schema, SQL Optimization</td>\n</tr>\n<tr>\n<td><code>frontend-specialist</code></td>\n<td>Frontend &amp; Growth (UI/UX + SEO)</td>\n</tr>\n<tr>\n<td><code>mobile-developer</code></td>\n<td>Mobile Specialist (Cross-platform)</td>\n</tr>\n